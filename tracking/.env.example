# Server Configuration
PORT=5007
NODE_ENV=development

# Database Configuration (uses monorepo Postgres env vars)
# Monorepo pattern: POSTGRES_* or DB_*
POSTGRES_HOST=13.126.11.184
POSTGRES_PORT=5432
POSTGRES_DATABASE=serveaso1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=serveaso
POSTGRES_SSL=false

# Alternative DB_* prefix (legacy compatibility)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=serveaso
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_SSL=false

# Redis Configuration
REDIS_HOST=painstaking-turn-practical-89123.db.redis.io
REDIS_PORT=18399
REDIS_PASSWORD=sepJebtAheIZ9SfORvbjjDOUw909G6sZ
REDIS_DB=0

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# JWT Configuration
JWT_SECRET=your_jwt_secret_key

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://servease-innovation.netlify.app

# WebSocket Configuration
WS_PING_INTERVAL=30000
WS_MAX_RECONNECT_ATTEMPTS=5

# Location Update Configuration
LOCATION_UPDATE_INTERVAL=30000
LOCATION_HISTORY_SIZE=10
LOCATION_CACHE_TTL=3600

# ETA Configuration
ETA_CACHE_TTL=120
ETA_CALCULATION_INTERVAL=120000

# Position Estimation Configuration
MAX_ESTIMATION_TIME=600
ESTIMATION_CONFIDENCE_DECAY=0.1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5
LOCATION_UPDATE_RATE_LIMIT=15000

# Monitoring
METRICS_PORT=9090
